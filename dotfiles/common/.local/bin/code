#!/usr/bin/env bash

set -euo pipefail

for candidate in \
    /mnt/c/Users/*/AppData/Local/Programs/Microsoft\ VS\ Code/bin/code \
    "/mnt/c/Program Files/Microsoft VS Code/bin/code"
do
    if [[ -x "$candidate" ]]; then
        exec "$candidate" "$@"
    fi
done

echo "Windows Visual Studio Code was not found." >&2
exit 127
