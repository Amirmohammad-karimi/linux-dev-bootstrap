# Machine-specific configuration.
# Copy this file to config/local.env and edit as needed.
#
# Use "yes" or "no" for every ENABLE_* value.
# "no" means the bootstrap will not explicitly install/manage that component.
# A package may still exist already or be pulled as an unavoidable dependency
# of another enabled package.

# ---------------------------------------------------------------------------
# Bootstrap / configuration
# ---------------------------------------------------------------------------
ENABLE_SUDO_KEEPALIVE="yes"
ENABLE_MANAGED_DOTFILES="yes"

# ---------------------------------------------------------------------------
# Base Linux packages
# ---------------------------------------------------------------------------
ENABLE_BASE_PACKAGES="yes"
ENABLE_CA_CERTIFICATES="yes"
ENABLE_CURL="yes"
ENABLE_WGET="yes"
ENABLE_GIT="yes"
ENABLE_JQ="yes"
ENABLE_UNZIP="yes"
ENABLE_ZIP="yes"
ENABLE_TAR="yes"
ENABLE_XZ_UTILS="yes"
ENABLE_BUILD_ESSENTIAL="yes"
ENABLE_SOFTWARE_PROPERTIES_COMMON="yes"
ENABLE_GNUPG="yes"
ENABLE_LSB_RELEASE="yes"
ENABLE_STOW="yes"
ENABLE_TREE="yes"
ENABLE_HTOP="yes"
ENABLE_FILE="yes"
ENABLE_RSYNC="yes"
ENABLE_OPENSSH_CLIENT="yes"

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
ENABLE_PYTHON_TOOLCHAIN="yes"
ENABLE_PYTHON3="yes"
ENABLE_PYTHON_PIP="yes"
ENABLE_PYTHON_VENV="yes"
ENABLE_PYTHON_DEV="yes"
ENABLE_PIPX="yes"
ENABLE_UV="yes"

# ---------------------------------------------------------------------------
# Node.js
# ---------------------------------------------------------------------------
ENABLE_NODE_TOOLCHAIN="yes"
ENABLE_NVM="yes"
ENABLE_NODEJS="yes"
# npm and npx are bundled with Node.js.

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
ENABLE_DOCKER="yes"
ENABLE_DOCKER_ENGINE="yes"
ENABLE_DOCKER_CLI="yes"
ENABLE_CONTAINERD="yes"
ENABLE_DOCKER_BUILDX="yes"
ENABLE_DOCKER_COMPOSE="yes"
ENABLE_DOCKER_NONROOT="yes"

# ---------------------------------------------------------------------------
# General applications
# ---------------------------------------------------------------------------
ENABLE_GENERAL_TOOLS="yes"
ENABLE_GOOGLE_CHROME="no"

# ---------------------------------------------------------------------------
# VS Code / WSL
# ---------------------------------------------------------------------------
ENABLE_VSCODE="yes"
ENABLE_VSCODE_EXTENSIONS="yes"
ENABLE_VSCODE_PYTHON="yes"
ENABLE_VSCODE_DEBUGPY="yes"
ENABLE_VSCODE_PYLANCE="yes"
ENABLE_VSCODE_PYTHON_ENVS="yes"
ENABLE_VSCODE_CMAKE_TOOLS="yes"
ENABLE_VSCODE_CPP_DEVTOOLS="yes"
ENABLE_VSCODE_CHATGPT="yes"
ENABLE_VSCODE_SERIAL_MONITOR="yes"
ENABLE_VSCODE_MEMORY_INSPECTOR="yes"

# ---------------------------------------------------------------------------
# STM32 development
# ---------------------------------------------------------------------------
ENABLE_STM32="yes"
ENABLE_STM32_VSCODE_EXTENSION="yes"
ENABLE_STM32_CMAKE="yes"
ENABLE_STM32_GCC="yes"
ENABLE_STM32_NINJA="yes"
ENABLE_STM32_PROGRAMMER="yes"
ENABLE_STM32_CLANGD="yes"
ENABLE_STLINK_GDBSERVER="yes"
ENABLE_STLINK_UDEV_RULES="yes"
ENABLE_LIBUSB="yes"
ENABLE_LIBUSB_DEV="yes"
ENABLE_UDEV="yes"
ENABLE_USBUTILS="yes"
ENABLE_STLINK_USBIPD="yes"

# ---------------------------------------------------------------------------
# STM32CubeMX
# ---------------------------------------------------------------------------
ENABLE_STM32CUBEMX="yes"

# ---------------------------------------------------------------------------
# AI tools
# ---------------------------------------------------------------------------
ENABLE_AI_TOOLS="yes"
ENABLE_OPENCODE="yes"
ENABLE_CHATGPT="no"
ENABLE_ANTIGRAVITY_CLI="no"
ENABLE_ANTIGRAVITY_DESKTOP="no"
ENABLE_FREEBUFF_CLI="no"
ENABLE_FREEBUFF_DESKTOP="no"
ENABLE_FREEBUFF_FUSE_COMPAT="yes"
ENABLE_OLLAMA="no"
ENABLE_OLLAMA_ZSTD="yes"
OLLAMA_MODEL=""
